{
  "manifest_version": 3,
  "name": "FingerprintSync",
  "description": "Synchronized fingerprint spoofing + WebRTC leak protection + Local Network blocking + Protocol scheme protection + Link Cleaner + Regex URL blocker — all in one.",
  "version": "2.0.1",
  "author": "FingerprintSync",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [],
  "incognito": "spanning"
}
